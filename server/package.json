{
  "name": "aivorah-server",
  "version": "1.0.0",
  "description": "Aivorah backend — Qdrant RAG + Groq LLM",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "seed:pyp:g3": "node scripts/seed-pyp-grade3-full.js",
    "seed:pyp:g4": "node scripts/seed-pyp-grade4-full.js",
    "seed:pyp:g5": "node scripts/seed-pyp-grade5-full.js",
    "seed:pyp:all": "node scripts/seed-pyp-grade3-full.js && node scripts/seed-pyp-grade4-full.js && node scripts/seed-pyp-grade5-full.js",
    "seed:grade3": "node scripts/seed-pyp-grade3-full.js",
    "seed:ncert": "node scripts/seed-ncert-math.js",
    "seed:multi-curriculum:g1-g5": "node scripts/seed-multi-curriculum-g1-g5-semantic.js",
    "ingest:ncert-grade3": "node scripts/ingest-ncert-grade3-book.js",
    "ingest:ncert-grade3-mm": "node scripts/ingest-ncert-grade3-multimodal.js",
    "video:chapter:package": "node scripts/build-canva-chapter-package.js",
    "video:chapter:g3:living": "node scripts/build-canva-chapter-package.js --lesson science_g3_living_non_living_script.json",
    "canva:oauth": "node scripts/canva-oauth.js",
    "test": "jest --verbose"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/generative-ai": "^0.24.1",
    "@qdrant/js-client-rest": "^1.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.6",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.8.0",
    "groq-sdk": "^0.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.7.284",
    "puppeteer": "^24.40.0",
    "razorpay": "^2.9.6",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.0"
